<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>unpakz</AssemblyName>
    <RootNamespace>Unpakz.Cli</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <!-- the native backend, built by scripts/native-win.ps1; it must sit next to the executable -->
    <UnpakzNativeDll Condition="'$(UnpakzNativeDll)' == ''">$(MSBuildThisFileDirectory)..\..\native\build-msvc\unpakz_native.dll</UnpakzNativeDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(UnpakzNativeDll)')">
    <Content Include="$(UnpakzNativeDll)" Link="unpakz_native.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\Unpakz.Interop\Unpakz.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Unpakz.Windows.Tests" />
  </ItemGroup>
</Project>
